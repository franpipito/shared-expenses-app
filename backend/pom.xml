<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.gastoscompartidos</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>API de gastos compartidos entre dos personas</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<!-- MongoDB. Trae Spring Data MongoDB y el driver sincronico.
		     Reemplaza a spring-boot-starter-data-jpa: no hay Hibernate, no hay
		     JPQL y no hay ddl-auto. Lo que se conserva del mundo Spring Data es
		     la forma: repositorios como interfaces, consultas derivadas del
		     nombre del metodo, y @Version para bloqueo optimista. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Endpoint de salud, que es lo que Railway consulta para saber si el
		     contenedor esta vivo antes de mandarle trafico. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
		     ACA ESTABA FLYWAY, y su ausencia es la perdida mas seria de la
		     migracion a Mongo.

		     Con Postgres habia migraciones versionadas con checksum y
		     ddl-auto=validate: si una entidad no coincidia con su tabla, la app
		     NO ARRANCABA. Mongo no tiene esquema, asi que esa red no existe. Un
		     campo que se agrega y no se migra simplemente llega null en
		     produccion, y te enteras cuando algo se rompe raro tres pantallas
		     mas alla.

		     Lo que se puede hacer y esta hecho: las categorias las siembra
		     SembradorDeCategorias al arrancar, y los indices los declara
		     @CompoundIndex en la entidad. Lo que NO se puede hacer es detectar
		     documentos viejos con la forma vieja. Si algun dia hacen falta
		     migraciones de datos de verdad, la herramienta del ecosistema es
		     Mongock.
		-->

		<!--
			jjwt viene partido en tres a proposito: tu codigo compila solo contra
			la API, y la implementacion entra en runtime. Asi no podes usar sin
			querer clases internas que cambian entre versiones.
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
